# Скопировать в .env (.env в git не попадает).
#
# Движок синтеза: piper | say. Пусто = первый доступный: piper, если обе модели
# на месте, иначе say на macOS.
AIDEMY_TTS=
# Устройство: auto | cuda | cpu. auto пишет фактическое в карточку и манифест.
AIDEMY_DEVICE=auto
# Каталог моделей внутри контейнера (том D:/llm/aidemy).
AIDEMY_MODEL_DIR=/opt/aidemy/models
# Ведущие: движок:голос. Голоса piper для русского: denis, dmitri, irina, ruslan
# (все medium) — их печатает get_voices.py --list ru.
AIDEMY_VOICE_A=piper:ru_RU-denis-medium
AIDEMY_VOICE_B=piper:ru_RU-irina-medium
# Голоса macOS `say` (только если кто-то идёт этим путём).
AIDEMY_SAY_A=Samantha
AIDEMY_SAY_B=Daniel
