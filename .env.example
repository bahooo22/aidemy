# Скопировать в .env (.env в git не попадает).
#
# Движок синтеза: kokoro | silero | piper | say. Пусто = первый доступный.
# edge (онлайн-голоса Microsoft) в этом билде нет: мужской ru-голос на замере
# отдавал NoAudioReceived на четырёх репликах из пяти.
AIDEMY_TTS=
# Устройство для torch-движков: auto | cuda | cpu. Фактическое пишется в render.json.
AIDEMY_DEVICE=auto
# Каталог моделей внутри контейнера (том D:/llm/aidemy).
AIDEMY_MODEL_DIR=/opt/aidemy/models
# Ведущие: две независимые тройки движок:голос[:питч]. Питч в полутонах,
# допускает отрицательные значения: `piper:ru_RU-irina-medium:-4`.
# Голоса piper для русского: denis, dmitri, irina, ruslan — их печатает
# get_voices.py --list ru.
AIDEMY_VOICE_A=piper:ru_RU-denis-medium
AIDEMY_VOICE_B=piper:ru_RU-irina-medium
# Один рассказчик: 1 — ведущий B говорит тройкой ведущего A.
AIDEMY_ONE_VOICE=
# Голоса macOS `say` (только если кто-то идёт этим путём).
AIDEMY_SAY_A=Samantha
AIDEMY_SAY_B=Daniel
