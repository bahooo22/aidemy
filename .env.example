# Скопировать в .env (.env в git не попадает).
#
# Движок синтеза: piper | kokoro | silero | edge. Пусто = авто по качеству:
# kokoro -> silero -> piper -> edge.
AIDEMY_TTS=
# Устройство: auto | cuda | cpu. auto пишет фактическое в карточку и манифест.
AIDEMY_DEVICE=auto
# Каталог моделей внутри контейнера (том D:/llm/aidemy).
AIDEMY_MODEL_DIR=/opt/aidemy/models
# Ведущие: движок:голос[:питч]. Голоса: kokoro dima/sveta/masha,
# silero aidar/baya/kseniya/xenia/eugene, piper denis/dmitri/irina/ruslan.
AIDEMY_VOICE_A=kokoro:dima
AIDEMY_VOICE_B=kokoro:sveta
# Один рассказчик вместо диалога: 1
AIDEMY_ONE_VOICE=
# Голоса macOS `say` (только если кто-то идёт этим путём).
AIDEMY_SAY_A=Samantha
AIDEMY_SAY_B=Daniel
